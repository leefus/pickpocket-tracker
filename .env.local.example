# Copy to .env.local for local dev. In Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit the real file.

# A Notion internal integration token (https://notion.so/my-integrations).
# The integration needs Read, Update and Insert content, and must be
# connected to BOTH the "Pickpocket Match Log" and "Pickpocket Decks"
# databases (••• → Connections on each).
NOTION_TOKEN=ntn_replace_me

# Data source ids (not the database ids from the URLs).
NOTION_MATCHES_DATA_SOURCE_ID=7a5da861-6c8f-46e4-89b9-16ef5eec2edc
NOTION_DECKS_DATA_SOURCE_ID=68ee469c-97d6-438e-8ac7-7971f6f93e57

# Passcode for adding decks and adding or removing matches. Leave empty to
# make the site read-only.
TRACKER_PASSCODE=
